---
// Resume page with isolated styles - no global CSS imports
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>전민지 - Frontend Engineer</title>
		<style is:global>
			@import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css");
			@import url("https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap");

			/* Reset all styles for resume page */
			html,
			body {
				margin: 0;
				padding: 0;
				width: 100%;
				height: 100%;
			}

			:root {
				--ink: #000000;
				--charcoal: #1a1a1a;
				--dark-gray: #333333;
				--medium-gray: #666666;
				--stone: #999999;
				--light-gray: #e5e5e5;
				--pale-gray: #f5f5f5;
				--white: #ffffff;
				--accent: #00A1FF;
				--accent-dark: #0087D9;
				--accent-soft: #EAF7FF;
				--border: #e0e0e0;
			}

			@media print {
				/* 배경색 출력 강제 */
				* {
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
				}

				@page {
					margin: 12mm;
				}

				.resume-page {
					background: var(--white) !important;
				}

				.resume-page .container {
					max-width: none;
					box-shadow: none;
				}

				.resume-page .header {
					padding: 14px 0 12px;
					grid-template-columns: minmax(0, 1fr) 92px;
					column-gap: 16px;
				}

				.resume-page .profile-frame {
					width: 92px;
					height: 92px;
					box-shadow: none;
				}

				.resume-page .content {
					padding: 16px 0 0;
				}

				.resume-page .section {
					margin-bottom: 16px;
				}

				.resume-page .about-section {
					padding: 14px;
					margin-bottom: 16px;
				}

				.resume-page .about-body {
					font-size: 11px;
					line-height: 1.55;
				}

				.resume-page .snapshot-card {
					min-height: auto;
					padding: 8px;
				}

				.resume-page .experience-item,
				.resume-page .project-item {
					break-inside: avoid;
					page-break-inside: avoid;
				}

				.resume-page .section-header {
					break-after: avoid;
					page-break-after: avoid;
				}

			}

			.resume-page * {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			.resume-page {
				font-family:
					"Pretendard",
					-apple-system,
					BlinkMacSystemFont,
					system-ui,
					sans-serif !important;
				font-weight: 400 !important;
				line-height: 1.6 !important;
				color: var(--ink) !important;
				background: var(--pale-gray) !important;
				min-height: 100vh !important;
				margin: 0 !important;
				padding: 0 !important;
			}

			.resume-page .container {
				max-width: 820px;
				margin: 0 auto;
				background: var(--white);
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
			}

			/* Minimal CV Header */
			.resume-page .header {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 112px;
				column-gap: 24px;
				align-items: start;
				padding: 28px 40px 18px;
				border-bottom: 2px solid var(--accent);
			}

			.resume-page .header-left {
				grid-column: 1;
				grid-row: 1;
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 14px;
				margin-bottom: 6px;
				padding: 0;
				background: transparent;
				min-width: 0;
			}

			.resume-page .header-left::before {
				display: none;
			}

			.resume-page .name {
				font-family: "Archivo", sans-serif;
				font-size: 30px;
				font-weight: 800;
				color: var(--ink);
				letter-spacing: -0.02em;
				margin: 0;
			}

			.resume-page .title {
				font-size: 12px;
				font-weight: 400;
				color: var(--stone);
				letter-spacing: 0.02em;
				overflow-wrap: anywhere;
			}

			.resume-page .years-indicator {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				margin-top: 0;
				margin-left: auto;
			}

			.resume-page .years-dot {
				width: 6px;
				height: 6px;
				background: var(--accent);
				border-radius: 50%;
			}

			.resume-page .years-text {
				color: var(--medium-gray);
				font-size: 12px;
				font-weight: 500;
				opacity: 1;
			}

			.resume-page .header-right {
				grid-column: 1;
				grid-row: 2;
				padding: 0;
				background: transparent;
				margin-top: 6px;
				display: block;
				min-width: 0;
			}

			.resume-page .profile-frame {
				grid-column: 2;
				grid-row: 1 / span 2;
				justify-self: end;
				width: 112px;
				height: 112px;
				border-radius: 50%;
				padding: 0;
				background: var(--white);
				border: none;
				box-shadow: none;
				outline: none;
				overflow: hidden;
			}

			.resume-page .profile-photo {
				display: block;
				width: 100%;
				height: 100%;
				border-radius: 50%;
				border: none;
				box-shadow: none;
				outline: none;
				object-fit: cover;
				object-position: 61% 35%;
				filter: grayscale(100%);
			}

			.resume-page .contact-list {
				display: flex;
				flex-direction: row;
				flex-wrap: wrap;
				gap: 14px;
			}

			.resume-page .contact-item {
				display: flex;
				align-items: center;
				gap: 5px;
				font-size: 12px;
				color: var(--medium-gray);
			}

			.resume-page .contact-icon {
				width: 14px;
				height: 14px;
				background: transparent;
				border-radius: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				border: none;
			}

			.resume-page .contact-icon svg {
				width: 13px;
				height: 13px;
				stroke: var(--medium-gray);
			}

			.resume-page .contact-text {
				color: var(--charcoal);
				text-decoration: none;
				transition: color 0.2s ease;
				font-size: 12px;
			}

			.resume-page .contact-text:hover {
				color: var(--accent);
			}

			/* Main Content */
			.resume-page .content {
				padding: 24px 40px 32px;
			}

			/* About Section - minimal */
			.resume-page .about-section {
				margin-bottom: 22px;
				padding: 18px 18px 16px;
				background: linear-gradient(180deg, var(--white) 0%, #f9fcff 100%);
				border: 1px solid var(--light-gray);
				border-left: 4px solid var(--accent);
				position: relative;
			}

			.resume-page .about-kicker {
				font-family: "Archivo", sans-serif;
				font-size: 11px;
				font-weight: 800;
				color: var(--accent-dark);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				margin-bottom: 8px;
			}

			.resume-page .about-text {
				font-size: 15px;
				line-height: 1.55;
				color: var(--ink);
				font-weight: 700;
				margin: 0 0 10px;
				letter-spacing: -0.01em;
			}

			.resume-page .about-text strong {
				font-weight: 700;
				background: var(--accent);
				color: var(--white);
				padding: 0 2px;
			}

			.resume-page .about-body {
				font-size: 12.5px;
				line-height: 1.72;
				color: var(--charcoal);
				margin-top: 0;
			}

			.resume-page .about-body + .about-body {
				margin-top: 7px;
			}

			.resume-page .overview-section {
				margin-bottom: 24px;
			}

			.resume-page .snapshot-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 8px;
				margin-bottom: 12px;
			}

			.resume-page .snapshot-card {
				min-height: 86px;
				padding: 10px;
				border: 1px solid var(--light-gray);
				background: var(--white);
			}

			.resume-page .snapshot-label {
				display: block;
				font-family: "Archivo", sans-serif;
				font-size: 10px;
				font-weight: 800;
				color: var(--stone);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				margin-bottom: 5px;
			}

			.resume-page .snapshot-value {
				font-size: 12px;
				line-height: 1.45;
				font-weight: 700;
				color: var(--ink);
				white-space: normal;
				word-break: keep-all;
				overflow-wrap: anywhere;
			}

			.resume-page .snapshot-note {
				margin-top: 4px;
				font-size: 10.5px;
				line-height: 1.4;
				color: var(--medium-gray);
			}

			.resume-page .about-list {
				list-style: none;
				padding: 0;
				margin: 18px 0 0 0;
			}

			.resume-page .about-list li {
				position: relative;
				padding-left: 14px;
				margin-bottom: 6px;
				font-size: 14px;
				line-height: 1.65;
				color: var(--charcoal);
			}

			.resume-page .about-list li:last-child {
				margin-bottom: 0;
			}

			.resume-page .about-list li::before {
				content: "·";
				position: absolute;
				left: 2px;
				top: -2px;
				color: var(--medium-gray);
				font-weight: 700;
				font-size: 18px;
			}

			.resume-page .about-list strong {
				font-weight: 700;
				color: var(--ink);
			}

			/* Section Headers - minimal */
			.resume-page .section {
				margin-bottom: 24px;
			}

			.resume-page .section--projects {
				margin-top: 0;
			}

			.resume-page .section-header {
				display: flex;
				align-items: baseline;
				gap: 10px;
				margin-bottom: 14px;
				padding-bottom: 6px;
				border-bottom: 1px solid var(--light-gray);
				position: relative;
			}

			.resume-page .section-number {
				background: var(--accent);
				color: var(--white);
				border-radius: 2px;
				display: inline-block;
				font-weight: 700;
				font-size: 11px;
				padding: 1px 5px;
				font-family: "Archivo", sans-serif;
				letter-spacing: 0.04em;
			}

			.resume-page .section-title {
				font-family: "Archivo", sans-serif;
				font-size: 15px;
				font-weight: 700;
				color: var(--ink);
				text-transform: uppercase;
				letter-spacing: 0.06em;
			}

			/* Experience Cards */
			.resume-page .experience-item {
				display: grid;
				grid-template-columns: 130px 1fr;
				gap: 24px;
				margin-bottom: 18px;
				padding: 0;
				background: transparent;
				border: none;
				transition: none;
			}

			.resume-page .experience-item:hover {
				transform: none;
				box-shadow: none;
			}

			.resume-page .experience-period {
				padding-top: 2px;
			}

			.resume-page .experience-date {
				font-size: 12px;
				font-weight: 600;
				color: var(--charcoal);
				letter-spacing: 0;
			}

			.resume-page .experience-duration {
				font-size: 11px;
				color: var(--stone);
				margin-top: 2px;
			}

			.resume-page .experience-content {
				padding-top: 0;
			}

			.resume-page .experience-title {
				font-size: 15px;
				font-weight: 700;
				color: var(--ink);
				margin-bottom: 2px;
			}

			.resume-page .experience-company {
				font-size: 15px;
				color: var(--ink);
				font-weight: 700;
				margin-bottom: 6px;
			}

			.resume-page .experience-description {
				font-size: 12px;
				color: var(--medium-gray);
				margin-bottom: 8px;
				line-height: 1.55;
				font-style: italic;
			}

			.resume-page .experience-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.resume-page .experience-list li {
				position: relative;
				padding-left: 12px;
				margin-bottom: 3px;
				font-size: 13px;
				line-height: 1.6;
				color: var(--charcoal);
			}

			.resume-page .experience-list li:last-child {
				margin-bottom: 0;
			}

			.resume-page .experience-list li::before {
				content: "·";
				position: absolute;
				left: 2px;
				top: -2px;
				color: var(--medium-gray);
				font-weight: 700;
				font-size: 18px;
			}

			.resume-page .experience-list strong {
				font-weight: 700;
				color: var(--ink);
			}

			/* Projects - minimal */
			.resume-page .project-item {
				padding: 0 0 0 14px;
				background: transparent;
				margin-bottom: 14px;
				position: relative;
				border-left: 2px solid var(--accent);
			}

			.resume-page .project-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 4px;
				gap: 12px;
			}

			.resume-page .project-title {
				font-size: 14px;
				font-weight: 700;
				color: var(--ink);
			}

			.resume-page .project-period {
				font-size: 11px;
				color: var(--stone);
				font-weight: 500;
				flex-shrink: 0;
			}

			.resume-page .project-tech {
				display: flex;
				flex-wrap: wrap;
				gap: 4px;
				margin-bottom: 6px;
			}

			.resume-page .tech-chip {
				display: inline-block;
				font-size: 11px;
				color: var(--medium-gray);
				font-weight: 500;
				background: transparent;
				border: none;
				padding: 0;
				border-radius: 0;
				letter-spacing: 0;
			}

			.resume-page .tech-chip:not(:last-child)::after {
				content: " ·";
				margin-left: 2px;
				color: var(--light-gray);
			}

			.resume-page .project-description {
				font-size: 13px;
				color: var(--charcoal);
				line-height: 1.6;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.resume-page .project-description li {
				position: relative;
				padding-left: 12px;
				margin-bottom: 3px;
			}

			.resume-page .project-description li:last-child {
				margin-bottom: 0;
			}

			.resume-page .project-description li::before {
				content: "·";
				position: absolute;
				left: 2px;
				top: -2px;
				color: var(--medium-gray);
				font-weight: 700;
				font-size: 18px;
			}

			.resume-page .project-description strong {
				font-weight: 700;
				color: var(--ink);
			}

			/* Education - minimal */
			.resume-page .education-item {
				padding: 0;
				background: transparent;
				border: none;
				display: grid;
				grid-template-columns: 130px 1fr;
				gap: 24px;
				align-items: baseline;
			}

			.resume-page .education-icon {
				display: none;
			}

			.resume-page .education-content {
				flex: 1;
			}

			.resume-page .education-degree {
				font-size: 13px;
				font-weight: 700;
				color: var(--ink);
				margin-bottom: 2px;
			}

			.resume-page .education-school {
				font-size: 12px;
				color: var(--charcoal);
				margin-bottom: 0;
			}

			.resume-page .education-date {
				font-size: 12px;
				color: var(--charcoal);
				font-weight: 600;
			}

			/* Activities - minimal */
			.resume-page .activities-list {
				display: flex;
				flex-direction: column;
				gap: 4px;
			}

			.resume-page .activity-item {
				padding: 4px 0 4px 12px;
				background: transparent;
				border-left: 2px solid var(--accent);
				font-size: 13px;
				color: var(--charcoal);
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.resume-page a.activity-item::after {
				content: "↗";
				flex-shrink: 0;
				color: var(--accent);
				font-size: 16px;
				font-weight: 700;
				transition: transform 0.2s ease;
			}

			.resume-page a.activity-item:hover {
				background: transparent;
				color: var(--accent-dark);
				transform: none;
			}

			.resume-page a.activity-item:hover::after {
				transform: translate(2px, -2px);
			}

			/* Testimonials Section */
			.resume-page .testimonials-section {
				margin-bottom: 0;
			}

			.resume-page .education-section {
				margin-top: 8px;
			}

			.resume-page .testimonial-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 10px;
			}

			.resume-page .testimonial-card {
				padding: 12px 14px;
				background: var(--white);
				border: 1px solid var(--light-gray);
				border-left: 3px solid var(--accent);
				position: relative;
			}

			.resume-page .testimonial-content {
				font-size: 10.5px;
				line-height: 1.6;
				color: var(--charcoal);
				margin-bottom: 8px;
				font-style: italic;
			}

			.resume-page .testimonial-author {
				display: flex;
				align-items: center;
				gap: 6px;
			}

			.resume-page .testimonial-role {
				font-size: 10px;
				font-weight: 700;
				color: var(--ink);
			}

			.resume-page .testimonial-company {
				font-size: 10px;
				color: var(--stone);
			}

			.resume-page .testimonial-divider {
				width: 14px;
				height: 1px;
				background: var(--light-gray);
			}

			/* Responsive */
			@media (max-width: 768px) {
				.resume-page .header {
					grid-template-columns: minmax(0, 1fr) 96px;
				}

				.resume-page .profile-frame {
					width: 96px;
					height: 96px;
				}

				.resume-page .snapshot-grid {
					grid-template-columns: repeat(2, 1fr);
				}

				.resume-page .snapshot-value {
					white-space: normal;
				}

				.resume-page .experience-item {
					grid-template-columns: 1fr;
					gap: 16px;
				}

			}

			@media (max-width: 600px) {
				.resume-page .header {
					grid-template-columns: minmax(0, 1fr) 76px;
					padding: 22px 16px 18px;
					column-gap: 14px;
				}

				.resume-page .header-left {
					gap: 8px;
				}

				.resume-page .title,
				.resume-page .years-indicator {
					flex-basis: 100%;
				}

				.resume-page .years-indicator {
					margin-left: 0;
					margin-top: 0;
				}

				.resume-page .header-right {
					grid-column: 1 / -1;
					grid-row: 2;
					margin-top: 12px;
				}

				.resume-page .profile-frame {
					grid-column: 2;
					grid-row: 1;
					width: 76px;
					height: 76px;
				}

				.resume-page .snapshot-grid {
					grid-template-columns: 1fr;
				}
			}

			/* Mobile (small phones, 360px~480px) */
			@media (max-width: 480px) {
				.resume-page .container {
					box-shadow: none;
				}

				/* Header: stack vertically */
				.resume-page .header {
					grid-template-columns: minmax(0, 1fr) 76px;
					min-height: auto;
					padding: 22px 16px 18px;
					column-gap: 14px;
				}
				.resume-page .header-left {
					padding: 0;
					gap: 8px;
					margin-bottom: 4px;
				}
				.resume-page .header-left::before {
					display: none;
				}
				.resume-page .name {
					font-size: 28px;
					margin-bottom: 0;
				}
				.resume-page .title {
					font-size: 12px;
				}
				.resume-page .years-indicator {
					margin-top: 4px;
					margin-left: 0;
				}
				.resume-page .header-right {
					grid-column: 1 / -1;
					grid-row: 2;
					padding: 0;
					margin-top: 12px;
				}
				.resume-page .profile-frame {
					width: 76px;
					height: 76px;
					grid-column: 2;
					grid-row: 1;
				}
				.resume-page .contact-list {
					gap: 8px 12px;
				}
				.resume-page .contact-text {
					font-size: 12px;
					word-break: break-all;
				}

				/* Content */
				.resume-page .content {
					padding: 24px 16px;
				}

				/* About */
				.resume-page .about-section {
					padding: 16px;
					margin-bottom: 28px;
				}
